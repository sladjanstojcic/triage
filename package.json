{
  "name": "triage-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "dist/desktop.mjs",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include vite.config.ts src/server/index.ts",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "build:desktop": "pnpm build && esbuild src/desktop/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/desktop.mjs && cp build/trayTemplate.png build/trayTemplate@2x.png dist/",
    "start": "NODE_ENV=production node dist/server.mjs",
    "desktop": "pnpm build:desktop && electron .",
    "desktop:package": "pnpm build:desktop && electron-builder --mac --dir",
    "lint": "eslint",
    "typecheck": "tsc",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "service:install": "sh scripts/launchd.sh install",
    "service:uninstall": "sh scripts/launchd.sh uninstall"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@12.4.2",
  "build": {
    "appId": "dev.triage.app",
    "productName": "Triage",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dir",
      "icon": "build/icon.png"
    }
  }
}
